      "credentials": {
        "smtp": {
          "id": "",
          "name": "Email_Jana_Treinamentos"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ayytbphndmfudxefposk.supabase.co/rest/v1/rpc/registrar_envio",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { p_notificacao: $('Tem e-mail?').item.json.id, p_ok: true } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        -100
      ],
      "id": "623410b1-7beb-5284-a581-14b8ab64e4b2",
      "name": "Registrar enviado",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Supabase Portal (apikey)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ayytbphndmfudxefposk.supabase.co/rest/v1/rpc/registrar_envio",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { p_notificacao: $('Tem e-mail?').item.json.id, p_ok: false, p_erro: String($json.error ?? 'Falha no envio').slice(0, 500) } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        100
      ],
      "id": "47551169-a203-5e42-b57c-e3ce87437d3d",
      "name": "Registrar erro",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Supabase Portal (apikey)"
        }
      }
    }
