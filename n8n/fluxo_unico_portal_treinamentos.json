        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "tem-id",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        100
      ],
      "id": "71039e6c-de90-565a-8cd7-89b263271615",
      "name": "Tem e-mail?"
    },
    {
      "parameters": {
        "fromEmail": "joliveira@emais.com",
        "toEmail": "={{ $json.destinatario }}",
        "subject": "={{ $json.assunto }}",
        "html": "={{ $json.corpo_html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        720,
        0
      ],
      "id": "ff5c8641-fc7d-57a1-8d99-e15308e88ca1",
